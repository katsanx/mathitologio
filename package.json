{
  "name": "mathitologio",
  "productName": "Μαθητολόγιο",
  "version": "2.19.2",
  "description": "Ψηφιακό Μαθητολόγιο — διαχείριση μαθητικού πληθυσμού δομής φιλοξενίας",
  "author": "Κατσιαντρίδης Χρήστος",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "imapflow": "^1.4.7",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.14",
    "pdf2json": "^4.0.3",
    "pizzip": "^3.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "gr.altosweb.mathitologio",
    "productName": "Μαθητολόγιο ΣΕΠ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "resources/libreoffice",
        "to": "libreoffice"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "build/EULA.txt",
        "to": "EULA.txt"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mathitologio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Μαθητολόγιο ΣΕΠ"
    },
    "publish": {
      "provider": "github",
      "owner": "katsanx",
      "repo": "mathitologio-releases",
      "private": false,
      "releaseType": "release"
    }
  }
}
